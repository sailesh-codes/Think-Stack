# Database Configuration
DATABASE_URL=mongodb://localhost:27017/thinkstack

# Server Configuration
PORT=5000
NODE_ENV=development

# OpenRouter Configuration (for AI features)
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_API_BASE=https://openrouter.ai/api/v1

# Per-model call limits for orchestration (optional overrides)
OPENROUTER_GPT4O_MINI_LIMIT=1000
OPENROUTER_GPT41_MINI_LIMIT=1000

# Session Configuration
SESSION_SECRET=your_session_secret_here

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Replit Auth Configuration (optional)
REPL_ID=your_repl_id_here
ISSUER_URL=https://replit.com/oidc
