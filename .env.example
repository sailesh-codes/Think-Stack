# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/thinkstack

# Server Configuration
PORT=5000
NODE_ENV=development

# OpenRouter Configuration (for AI features)
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_API_BASE=https://openrouter.ai/api/v1

# Per-model call limits for orchestration (optional overrides)
OPENROUTER_GPT4O_MINI_LIMIT=1000
OPENROUTER_GPT41_MINI_LIMIT=1000
